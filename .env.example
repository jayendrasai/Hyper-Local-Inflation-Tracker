# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Safe API Key & Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# This file IS committed to version control.
# It shows collaborators WHAT variables are needed WITHOUT exposing values.
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Edit .env:        nano .env   (or your preferred editor)
#   3. Fill in your real values below
#   4. NEVER commit .env — it is listed in .gitignore
#
# GET YOUR FREE API KEY:
#   https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── API Base URL (optional — defaults to OpenRouter's standard endpoint) ──────
# The SDK appends /chat/completions automatically; set only the base path.
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ── Model Selection (optional — safe defaults are set in config/settings.py) ──
# Text/analysis model — used for budget prediction & inflation analysis
STORY_MODEL=google/gemma-4-26b-a4b-it:free

# Vision/OCR model — used for receipt scanning via st.camera_input
# VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
